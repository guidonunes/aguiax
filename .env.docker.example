# Copie para .env.docker antes de executar o Docker Compose.
# Credenciais locais e descartáveis; não reutilize valores reais.
MYSQL_DATABASE=aguiax
MYSQL_USER=aguiax
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_ROOT_PASSWORD=change_this_mysql_root_password
MYSQL_HOST_PORT=3307

MONGODB_DATABASE=aguiax
MONGO_ROOT_USER=aguiax_admin
# Use caracteres seguros para uma URI ou aplique URL encoding ao valor.
MONGO_ROOT_PASSWORD=change_this_mongo_password
MONGODB_HOST_PORT=27018

JWT_SECRET=replace_with_a_long_random_local_jwt_secret_at_least_48_characters
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# A aplicação funciona sem IA quando false. Nunca distribua sua chave pessoal.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=15000
