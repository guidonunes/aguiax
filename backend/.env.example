# Required: MySQL database must already exist; Flyway creates its tables.
DB_URL=jdbc:mysql://localhost:3306/aguiaexpress
DB_USER=aguiaexpress_local
DB_PASSWORD=replace-with-local-password

# Required: private HMAC secret. Generate a unique long random value locally.
JWT_SECRET=replace-with-a-long-random-local-secret

# Required: MongoDB stores audit events and AI evaluation history.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aguiaexpress

# Optional Gemini integration. Keep disabled when no API key is configured.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_CONNECT_TIMEOUT_MS=3000
AI_READ_TIMEOUT_MS=15000

# SPRING_PROFILES_ACTIVE is intentionally not loaded from this file.
# Set SPRING_PROFILES_ACTIVE=local in the shell to enable local Swagger/OpenAPI.
